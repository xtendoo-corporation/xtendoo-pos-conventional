<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_make_payment_wizard_form" model="ir.ui.view">
        <field name="name">pos.make.payment.wizard.form</field>
        <field name="model">pos.make.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Realizar Pago" class="o_pos_conventional_payment_wizard_form">
                <field name="order_id" invisible="1" />
                <field name="config_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="currency_symbol" invisible="1" />
                <field name="available_payment_method_ids" invisible="1" />

                <div class="p-3 pb-0">
                    <!-- Cabecera de importes estilo Dashboard -->
                    <div class="row g-0 mb-4 border bg-100 rounded shadow-sm">
                        <div class="col-4 p-3 border-end text-center">
                            <div class="text-muted x-small fw-bold text-uppercase mb-1">Total a Pagar</div>
                            <field name="amount_total" widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1" nolabel="1"
                                class="fs-2 fw-bolder d-block"/>
                        </div>
                        <div class="col-4 p-3 border-end text-center">
                            <div class="text-muted x-small fw-bold text-uppercase mb-1">Pagado</div>
                            <field name="amount_paid" widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1" nolabel="1"
                                class="fs-2 fw-bolder d-block text-success"
                                invisible="amount_total &gt; 0 and amount_paid &lt; amount_total or amount_total &lt; 0 and amount_paid &gt; amount_total"/>
                            <field name="amount_paid" widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1" nolabel="1"
                                class="fs-2 fw-bolder d-block text-danger"
                                invisible="not (amount_total &gt; 0 and amount_paid &lt; amount_total or amount_total &lt; 0 and amount_paid &gt; amount_total)"/>
                        </div>
                        <div class="col-4 p-3 text-center">
                            <div class="text-muted x-small fw-bold text-uppercase mb-1">Cambio / Restante</div>
                            <field name="amount_change" widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1" nolabel="1"
                                class="fs-2 fw-bolder d-block text-success"
                                invisible="(amount_total &gt;= 0 and amount_change &gt; 0) or (amount_total &lt; 0 and amount_change &lt; 0)"/>
                            <field name="amount_change" widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1" nolabel="1"
                                class="fs-2 fw-bolder d-block text-danger"
                                invisible="(amount_total &gt;= 0 and amount_change &lt;= 0) or (amount_total &lt; 0 and amount_change &gt;= 0)"/>
                        </div>
                    </div>

                    <field name="is_cash_payment" invisible="1" />

                    <!-- Sección de Entrada de Pago: Destacada con un fondo suave -->
                    <div class="bg-light p-3 rounded border mb-4 shadow-sm">
                        <div class="d-flex align-items-start gap-3">
                            <div class="flex-grow-1">
                                <label for="amount_tendered" class="fw-bold mb-1 d-block text-primary" style="line-height: 20px;">Importe Entregado</label>
                                <div class="input-group o_pos_amount_group">
                                    <span class="input-group-text">
                                        <field name="currency_symbol" nolabel="1"/>
                                    </span>
                                    <field name="amount_tendered"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id', 'no_symbol': True}"
                                        nolabel="1"
                                        class="o_pos_amount_tendered fw-bold"/>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <label for="payment_method_id" class="fw-bold mb-1 d-block" style="line-height: 20px;">Diario</label>
                                <div class="d-flex align-items-center" style="height: 34px;">
                                    <field name="payment_method_id"
                                        options="{'no_create': True, 'no_open': True}"
                                        required="1"
                                        nolabel="1"
                                        class="w-100 mb-0"/>
                                </div>
                            </div>
                            <div style="flex: 0 0 200px;">
                                <div style="height: 21px;"></div> <!-- Compensación de altura de label -->
                                <button name="action_add_payment" type="object"
                                        class="btn btn-primary w-100 fw-bold d-flex align-items-center justify-content-center"
                                        style="height: 34px;">
                                    <i class="fa fa-plus-circle me-2"/> Añadir Pago
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Listado de Pagos -->
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-list me-2 text-muted"/>
                        <span class="fw-bold text-uppercase text-muted small">Pagos registrados</span>
                        <div class="flex-grow-1 border-top ms-2 opacity-25"></div>
                    </div>

                    <div class="border rounded overflow-hidden">
                        <field name="payment_ids"
                               nolabel="1"
                               mode="list"
                               class="mb-0"
                               options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
                            <list create="0" delete="1" edit="0" open_form_view="0" class="o_list_render_no_container">
                                <field name="payment_method_id" />
                                <field name="amount" sum="Total Pagado" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </list>
                        </field>
                        <div class="text-muted text-center py-4 bg-view" invisible="payment_ids">
                            <i class="fa fa-info-circle me-1"/> Aún no hay pagos registrados.
                        </div>
                    </div>
                </div>

                <footer class="p-3 border-top bg-100 rounded-bottom">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <button string="Descartar" special="cancel" class="btn btn-secondary btn-lg px-4" />

                        <button name="action_validate" type="object"
                            string="Confirmar y Validar"
                            class="btn btn-primary btn-lg px-5 fw-bolder shadow-sm"
                            icon="fa-check-circle"
                            invisible="amount_total &gt; 0 and amount_due &gt; 0.01" />
                    </div>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_pos_make_payment_wizard_cash_form" model="ir.ui.view">
        <field name="name">pos.make.payment.wizard.cash.form</field>
        <field name="model">pos.make.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pago en efectivo" class="o_pos_conventional_payment_wizard_form">
                <field name="is_cash_payment" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="currency_symbol" invisible="1" />
                <field name="order_id" invisible="1" />
                <field name="payment_method_id" invisible="1" />

                <!-- Resumen del ticket: filas apiladas, etiqueta e importe del mismo tamaño -->
                <div class="p-3 mb-3">
                    <!-- Fila 1: Total del ticket (fijo) -->
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                        <span class="fs-2 fw-bold">A pagar</span>
                        <field name="amount_total" widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                            readonly="1" nolabel="1"
                            class="fs-2 fw-bold text-end"/>
                    </div>
                    <!-- Fila 2: Importe entregado -->
                    <div class="mb-4">
                        <label for="amount_tendered" class="form-label fw-bold">Importe Entregado</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><field name="currency_symbol" nolabel="1"/></span>
                            <field name="amount_tendered"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'no_symbol': True}"
                                nolabel="1"
                                class="form-control text-end fs-2 fw-bold text-primary"/>
                        </div>
                    </div>
                    <!-- Fila 3: Cambio a devolver — verde si hay suficiente, rojo si falta -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fs-2 fw-bold">Cambio</span>
                        <div class="text-end">
                            <field name="amount_change" widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1" nolabel="1"
                                class="fs-2 fw-bold text-success"
                                invisible="(amount_total &gt;= 0 and amount_change &gt; 0) or (amount_total &lt; 0 and amount_change &lt; 0)"/>
                            <field name="amount_change" widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                readonly="1" nolabel="1"
                                class="fs-2 fw-bold text-danger"
                                invisible="(amount_total &gt;= 0 and amount_change &lt;= 0) or (amount_total &lt; 0 and amount_change &gt;= 0)"/>
                        </div>
                    </div>
                </div>
                <footer>
                    <div class="d-flex justify-content-start gap-2 w-100">
                        <button name="action_validate" type="object"
                            string="Validar"
                            class="btn-primary btn-lg"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary btn-lg"/>
                    </div>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_make_payment_wizard" model="ir.actions.act_window">
        <field name="name">Realizar Pago</field>
        <field name="res_model">pos.make.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pos_make_payment_wizard_form" />
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'large'}</field>
    </record>
</odoo>
