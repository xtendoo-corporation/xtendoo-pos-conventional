<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_payment_wizard_banner" model="ir.ui.view">
        <field name="name">pos.order.form.payment.wizard.banner</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="pos_conventional_core.view_pos_pos_form_inherit_pos_conventional_core"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="pos_cash_change_banner"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_pos_form_payment_wizard" model="ir.ui.view">
        <field name="name">pos.order.form.payment.wizard</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[1]" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="class">me-2</attribute>
            </xpath>
            <xpath expr="//header/button[1]" position="after">
                <field name="use_fast_payment" invisible="1"/>
                <field name="available_fast_payment_method_ids" invisible="1"/>
                <button name="action_open_payment_popup"
                        string="Pago"
                        type="object"
                        class="btn-primary me-1"
                        invisible="state != 'draft'"/>
                <button name="action_cancel_and_delete_order"
                        string="Cancelar"
                        type="object"
                        class="btn-secondary me-1"
                        context="{'skip_completeness_check': True}"
                        invisible="state != 'draft'"/>
                <widget name="pos_actionpad_fast_payment_buttons"
                        methods_field="available_fast_payment_method_ids"
                        class="me-1"
                        invisible="state != 'draft' or not use_fast_payment"/>
                <button name="action_delete_cancelled_order_from_form"
                        string="Eliminar"
                        type="object"
                        class="btn-danger me-1"
                        context="{'skip_completeness_check': True}"
                        invisible="state != 'cancel'"/>
            </xpath>
        </field>
    </record>

</odoo>
