<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_conventional_line_employees_view_pos_order_line_form_inherit" model="ir.ui.view">
        <field name="name">pos.order.line.form.employee</field>
        <field name="model">pos.order.line</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='product_id']" position="after">
                <field name="employee_ids"/>
            </xpath>
        </field>
    </record>

    <record id="pos_conventional_line_employees_view_pos_order_line_list_inherit" model="ir.ui.view">
        <field name="name">pos.order.line.list.employee</field>
        <field name="model">pos.order.line</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_line"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="employee_ids" optional="show" widget="many2many_tags" string="Empleado/s"/>
            </xpath>
        </field>
    </record>

    <record id="pos_conventional_line_employees_inherit_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.form.add_employees_to_lines</field>
        <field name="model">pos.order</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <!-- Insert employee_ids in the list of lines -->
            <xpath expr="//list[ancestor::field[@name='lines']]" position="inside">
                <field name="employee_ids" optional="show" widget="many2many_tags" string="Empleado/s"/>
            </xpath>

            <!-- Insert employee_ids in the line form -->
            <xpath expr="//form[ancestor::field[@name='lines']]//group[@col='4']" position="inside">
                <field name="employee_ids" widget="many2many_tags" string="Empleado/s"/>
            </xpath>
        </field>
    </record>
</odoo>
