<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El core define point_of_sale.rule_invoice_line_pos_user para el
         grupo POS User; se acota por caja en ResUsers._register_hook()
         (ver hooks.py). Aquí solo añadimos el mismo escape para managers y
         administradores: ven todas las líneas de factura POS si no tienen
         restricción explícita; si la tienen, solo las de esas cajas. -->
    <record id="account_move_line_rule_pos_manager_all" model="ir.rule">
        <field name="name">POS: Managers ven todas las líneas de factura POS (o restringidas)</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[(1, '=', 1)] if not user.allowed_pos_config_ids else ['|', ('move_id.pos_order_ids', '=', False), ('move_id.pos_order_ids.config_id', 'in', user.allowed_pos_config_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="account_move_line_rule_pos_system_all" model="ir.rule">
        <field name="name">POS: Admin Global ve todas las líneas de factura POS (o restringidas)</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[(1, '=', 1)] if not user.allowed_pos_config_ids else ['|', ('move_id.pos_order_ids', '=', False), ('move_id.pos_order_ids.config_id', 'in', user.allowed_pos_config_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
