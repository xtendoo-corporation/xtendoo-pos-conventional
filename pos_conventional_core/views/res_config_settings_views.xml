<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.conventional.core</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='payment_methods_new']" position="after">
                <setting id="pos_non_touch_setting" string="POS no táctil"
                    help="Activa un modo de punto de venta optimizado para equipos sin pantalla táctil.">
                    <field name="pos_non_touch" readonly="has_open_pos_sessions" />
                    <field name="has_open_pos_sessions" invisible="1" />
                </setting>
                <setting string="Cliente por Defecto"
                    help="Cliente que se asignará automáticamente a los nuevos pedidos POS creados desde el backend">
                    <field name="pos_default_partner_id"
                        placeholder="Seleccionar cliente por defecto..."
                        options="{'no_create': True}" />
                </setting>
                <setting id="pos_allow_draft_orders_setting" string="Ventas en borrador"
                    help="Si está marcado, se permite salir de un pedido en borrador sin finalizar el pago. Si no está marcado, el sistema obligará a finalizar el pago o cancelar el pedido antes de salir.">
                    <field name="pos_allow_draft_orders" />
                </setting>
                <div invisible="not has_open_pos_sessions" class="alert alert-warning mt-2" role="alert">
                    No se puede cambiar el modo táctil/no táctil mientras existan sesiones POS
                    abiertas.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
