<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_factura_simplificada_80mm_standard_qztray" model="ir.actions.report">
        <field name="name">Factura Simplificada 80mm QZ Tray Standard</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_conventional_qztray.report_factura_simplificada_80mm_standard_qztray</field>
        <field name="report_file">pos_conventional_qztray.report_factura_simplificada_80mm_standard_qztray</field>
        <field name="print_report_name">'Ticket_QZ_%s' % object.name.replace('/', '_')</field>
        <field name="paperformat_id" ref="pos_conventional_receipt_custom.paperformat_receipt_80mm"/>
    </record>

    <record id="action_pos_order_original_80mm_standard_qztray" model="ir.actions.report">
        <field name="name">Factura Simplificada 80mm QZ Tray Standard</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_conventional_qztray.report_pos_order_original_80mm_standard_qztray</field>
        <field name="report_file">pos_conventional_qztray.report_pos_order_original_80mm_standard_qztray</field>
        <field name="print_report_name">'Ticket_QZ_%s' % object.name.replace('/', '_')</field>
        <field name="paperformat_id" ref="pos_conventional_receipt_custom.paperformat_receipt_80mm"/>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_factura_simplificada_80mm_standard_qztray_document">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="o"/>
            <div class="page pos-qz-standard-ticket">
            <style>
                .pos-qz-standard-ticket {
                    font-size: 13px;
                    font-weight: 400;
                    line-height: 1.45;
                    color: #000;
                    padding: 2mm 3mm 4mm 3mm;
                    box-sizing: border-box;
                }
                .pos-qz-standard-ticket .text-center { text-align: center; }
                .pos-qz-standard-ticket .text-right { text-align: right; }
                .pos-qz-standard-ticket .text-left { text-align: left; }
                .pos-qz-standard-ticket .bold { font-weight: 700; }
                .pos-qz-standard-ticket .muted { font-size: 75%; }
                .pos-qz-standard-ticket .pt-3 { padding-top: 8px; }
                .pos-qz-standard-ticket .receipt-logo {
                    max-height: 70px;
                    max-width: 75%;
                    margin: 0 auto;
                    display: block;
                    filter: brightness(0);
                    -webkit-filter: brightness(0);
                }
                .pos-qz-standard-ticket .receipt-row {
                    display: table;
                    width: 100%;
                }
                .pos-qz-standard-ticket .receipt-row > span {
                    display: table-cell;
                }
                .pos-qz-standard-ticket .receipt-row .amount {
                    text-align: right;
                    white-space: nowrap;
                }
                .pos-qz-standard-ticket .dashed-line {
                    border: none;
                    border-bottom: 1px solid #000;
                    margin: 7px 0;
                    width: 100%;
                }
                .pos-qz-standard-ticket table {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    border: none !important;
                }
                .pos-qz-standard-ticket tr,
                .pos-qz-standard-ticket th,
                .pos-qz-standard-ticket td {
                    border: none !important;
                    outline: none !important;
                }
                .pos-qz-standard-ticket th {
                    font-weight: 700;
                    font-size: 12px;
                    border-bottom: 1px solid #000 !important;
                    padding: 3px 0;
                }
                .pos-qz-standard-ticket td {
                    vertical-align: top;
                    padding: 3px 0;
                    font-size: 13px;
                }
                .pos-qz-standard-ticket .col-name { width: 68%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
                .pos-qz-standard-ticket .col-ud { width: 10%; text-align: center; }
                .pos-qz-standard-ticket .col-total { width: 22%; text-align: right; }
                .pos-qz-standard-ticket .o_total_table td {
                    padding: 2px 0;
                    font-size: 13px;
                }
                .pos-qz-standard-ticket .o_total_table .o_total td,
                .pos-qz-standard-ticket .o_total_table .o_total strong {
                    font-size: 1.25em;
                    font-weight: 700;
                }
            </style>

            <t t-set="pos_order" t-value="o.pos_order_ids[:1] and o.pos_order_ids[0] or False"/>

            <div class="text-center" style="margin-bottom: 8px;">
                <img t-if="res_company.logo"
                    t-att-src="image_data_uri(res_company.logo)"
                    class="receipt-logo"/>
            </div>

            <div class="text-center muted">
                <div>
                    <span class="bold">Ticket</span>
                    <span t-field="o.name"/>
                </div>
                <div>
                    <span t-field="o.invoice_date"/>
                    <span t-field="o.create_date" t-options='{"format": "HH:mm"}'/>
                </div>
            </div>

            <div class="pt-3 text-center">
                <t t-if="pos_order and pos_order.config_id and pos_order.config_id.receipt_header">
                    <div style="white-space: pre-line;">
                        <span t-out="pos_order.config_id.receipt_header"/>
                    </div>
                </t>
                <div t-if="pos_order and pos_order.user_id" class="muted">
                    Atendido por: <span t-field="pos_order.user_id.name"/>
                </div>
            </div>

            <div class="dashed-line"/>

            <t t-if="o.partner_id">
                <div class="text-center">
                    <div><span t-field="o.partner_id.name"/></div>
                    <div t-if="o.partner_id.street"><span t-field="o.partner_id.street"/></div>
                    <div t-if="o.partner_id.zip">
                        <span t-field="o.partner_id.zip"/>
                        <span t-field="o.partner_id.city"/>
                    </div>
                    <div t-if="o.partner_id.vat">NIF: <span t-field="o.partner_id.vat"/></div>
                </div>
            </t>

            <div class="pt-3"/>

            <table>
                <thead>
                    <tr>
                        <th class="text-left col-name">Producto</th>
                        <th class="text-center col-ud">UD</th>
                        <th class="text-right col-total">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.invoice_line_ids" t-as="line">
                        <tr t-if="line.display_type == 'product'">
                            <td class="text-left col-name" style="padding-right: 2px;">
                                <t t-set="line_name" t-value="(line.name or '').split('] ', 1)[-1] if '] ' in (line.name or '') else (line.name or '')"/>
                                <span t-out="line_name" t-options="{'widget': 'text'}"/>
                            </td>
                            <td class="text-center col-ud"><span t-esc="'%.0f' % line.quantity"/></td>
                            <td class="text-right col-total">
                                <span t-field="line.price_total"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <table class="o_total_table table table-borderless" style="width: 100%; margin-top: 5px; margin-bottom: 5px;">
                <thead>
                    <tr>
                        <th class="text-left">Base</th>
                        <th class="text-center">IMPUESTO</th>
                        <th class="text-right">Cuota</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="o.tax_totals">
                        <t t-foreach="o.tax_totals['subtotals']" t-as="subtotal">
                            <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                <tr>
                                    <td class="text-left">
                                        <span t-out="tax_group['base_amount_currency']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-center">
                                        <span t-out="tax_group['group_name']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-out="tax_group['tax_amount_currency']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </t>
                    <tr class="o_total">
                        <td colspan="2" class="text-right"><strong>Total</strong></td>
                        <td class="text-right">
                            <strong t-out="o.tax_totals['total_amount_currency'] if o.tax_totals else o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="paymentlines text-start pt-3">
                <t t-if="o.pos_order_ids">
                    <t t-foreach="o.pos_order_ids" t-as="pos_order">
                        <t t-foreach="pos_order.payment_ids" t-as="payment">
                            <div class="receipt-row">
                                <span t-field="payment.payment_method_id.name"/>
                                <span class="amount" t-field="payment.amount"/>
                            </div>
                        </t>
                    </t>
                </t>
                <t t-if="not o.pos_order_ids and o.invoice_payments_widget">
                    <t t-set="payments" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                    <t t-foreach="payments" t-as="payment">
                        <div class="receipt-row">
                            <span t-out="payment['journal_name']"/>
                            <span class="amount" t-out="payment['amount']"/>
                        </div>
                    </t>
                </t>
            </div>

            <t t-if="pos_order and pos_order.config_id and pos_order.config_id.receipt_footer">
                <div class="text-center pt-3" style="white-space: pre-line;">
                    <span t-out="pos_order.config_id.receipt_footer"/>
                </div>
            </t>

            <div class="pt-3 muted">
                <div class="receipt-row">
                    <span style="width: 50%; text-align: left; word-break: break-word;">
                        <div t-if="pos_order" t-field="pos_order.config_id.name"/>
                        <div t-if="res_company.street" t-field="res_company.street"/>
                        <div>
                            <span t-if="res_company.city" t-field="res_company.city"/>
                            <span t-if="res_company.zip">, <span t-field="res_company.zip"/></span>
                        </div>
                    </span>
                    <span style="width: 50%; text-align: right; word-break: break-word;">
                        <div t-if="res_company.vat" t-field="res_company.vat"/>
                        <div t-if="res_company.phone">Tel: <span t-field="res_company.phone"/></div>
                        <div t-if="res_company.email" t-field="res_company.email"/>
                        <div t-if="res_company.website" t-field="res_company.website"/>
                    </span>
                </div>
            </div>

            <div class="text-center pt-3 muted">
                <span>Powered by <strong>Odoo</strong></span>
            </div>

            <div class="text-center pt-3">
                <t t-if="o.move_type == 'out_refund'">
                    <span class="bold">FACTURA SIMPLIFICADA RECTIFICATIVA:</span>
                </t>
                <t t-else="">
                    <span class="bold">FACTURA SIMPLIFICADA:</span>
                </t>
                <span t-field="o.name"/>
            </div>
            </div>
        </t>
    </template>

    <template id="report_factura_simplificada_80mm_standard_qztray">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
                <t t-call="pos_conventional_qztray.report_factura_simplificada_80mm_standard_qztray_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_pos_order_original_80mm_standard_qztray">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="pos_order">
                <t t-if="pos_order.account_move">
                    <t t-set="o" t-value="pos_order.account_move.with_context(lang=pos_order.account_move.partner_id.lang or pos_order.env.lang)"/>
                    <t t-call="pos_conventional_qztray.report_factura_simplificada_80mm_standard_qztray_document" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </t>
    </template>
</odoo>