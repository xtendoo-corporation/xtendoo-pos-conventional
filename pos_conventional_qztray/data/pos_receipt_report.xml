<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_factura_simplificada_80mm_qztray" model="ir.actions.report">
        <field name="name">Factura Simplificada 80mm QZ Tray</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">pos_conventional_qztray.report_factura_simplificada_80mm_qztray</field>
        <field name="report_file">pos_conventional_qztray.report_factura_simplificada_80mm_qztray</field>
        <field name="print_report_name">'Ticket_QZ_%s' % object.name.replace('/', '_')</field>
        <field name="paperformat_id" ref="pos_conventional_receipt_custom.paperformat_receipt_80mm"/>
    </record>

    <template id="report_factura_simplificada_80mm_qztray"
        inherit_id="pos_conventional_receipt_custom.report_factura_simplificada_80mm"
        primary="True">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' article ')]/style" position="after">
            <style>
                .page {
                    padding-left: 0.5mm !important;
                    padding-right: 0.5mm !important;
                    width: 62mm !important;
                    margin-left: 0 !important;
                    margin-right: 0 !important;
                    font-size: 15px !important;
                    line-height: 1.35 !important;
                    transform: scale(1.28);
                    transform-origin: top left;
                }
                table {
                    width: 100% !important;
                }
                th {
                    font-size: 14px !important;
                }
                td {
                    font-size: 15px !important;
                }
                .col-name { width: 65% !important; }
                .col-ud { width: 10% !important; }
                .col-total { width: 25% !important; }
            </style>
        </xpath>
    </template>
</odoo>
