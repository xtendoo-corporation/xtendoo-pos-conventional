<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_pos_order_80mm_qztray" model="ir.actions.report">
        <field name="name">Ticket POS 80mm QZ Tray</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_conventional_qztray.report_pos_order_80mm_qztray</field>
        <field name="report_file">pos_conventional_qztray.report_pos_order_80mm_qztray</field>
        <field name="print_report_name">'Ticket_QZ_%s' % object.name.replace('/', '_')</field>
    </record>

    <template id="report_pos_order_80mm_qztray">
        <t t-set="full_width" t-value="True"/>
        <t t-call="web.report_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <style>
                        body {
                            margin: 0 !important;
                            padding: 0 !important;
                            color: #000;
                            font-family: "Courier New", Courier, monospace;
                        }
                        .ticket {
                            width: 100%;
                            box-sizing: border-box;
                            padding: 2mm;
                            font-size: 13px;
                            line-height: 1.4;
                            color: #000;
                        }
                        .center { text-align: center; }
                        .right { text-align: right; }
                        .bold { font-weight: bold; }
                        .upper { text-transform: uppercase; }
                        .dashed-line {
                            border: none;
                            border-bottom: 1px dashed #000;
                            margin: 4px 0;
                            width: 100%;
                            height: 1px;
                        }
                        table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                        }
                        th {
                            font-size: 12px;
                            padding: 4px 0;
                            font-weight: bold;
                            border-bottom: 1px dashed #000 !important;
                        }
                        td {
                            padding: 2px 0;
                            font-size: 13px;
                            vertical-align: top;
                        }
                        .col-name { width: 67%; }
                        .col-qty { width: 15%; text-align: right; }
                        .col-total { width: 18%; text-align: right; }

                        .total-row {
                            font-size: 32px;
                            margin: 8px 0;
                            font-weight: bold;
                        }
                    </style>

                    <div class="ticket">
                        <div class="center" style="margin-bottom: 8px;">
                            <img t-if="company.logo"
                                t-att-src="image_data_uri(company.logo)"
                                style="max-height: 120px; max-width: 80%; filter: grayscale(100%) contrast(150%);"/>
                        </div>

                        <t t-if="o.config_id and o.config_id.receipt_header">
                            <div style="white-space: pre-line; margin-bottom: 5px;">
                                <span t-out="o.config_id.receipt_header"/>
                            </div>
                        </t>

                        <div class="bold upper" style="font-size: 1.1em;">
                            <span t-field="company.name"/>
                        </div>
                        <div t-if="company.street"><span t-field="company.street"/></div>
                        <div>
                            <span t-if="company.zip" t-field="company.zip"/>
                            <span t-if="company.city" t-field="company.city"/>
                        </div>
                        <div t-if="company.vat"><span t-field="company.vat"/></div>

                        <div class="dashed-line"/>

                        <t t-set="move" t-value="o.account_move"/>
                        <div style="margin: 2px 0;">
                            <span class="bold">
                                <t t-if="move and move.move_type == 'out_refund'">FACTURA SIMPLIFICADA RECT.:</t>
                                <t t-else="">FACTURA SIMPLIFICADA:</t>
                            </span>
                            <span t-if="move" t-field="move.name"/>
                            <span t-else="" t-field="o.name"/>
                        </div>
                        <div>
                            <span class="bold">FECHA:</span>
                            <span t-field="o.date_order" t-options='{"format": "dd/MM/yyyy HH:mm"}'/>
                        </div>

                        <t t-if="o.partner_id">
                            <div class="dashed-line"/>
                            <div class="bold">CLIENTE:</div>
                            <div><span t-field="o.partner_id.name"/></div>
                            <div t-if="o.partner_id.vat">NIF: <span t-field="o.partner_id.vat"/></div>
                        </t>

                        <div class="dashed-line"/>

                        <table>
                            <thead>
                                <tr>
                                    <th class="text-left col-name">Nombre</th>
                                    <th class="text-center col-qty">Und</th>
                                    <th class="text-right col-total">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.lines" t-as="line">
                                    <tr>
                                        <td class="col-name">
                                            <t t-set="line_name" t-value="line.full_product_name or line.product_id.display_name"/>
                                            <span t-out="line_name"/>
                                        </td>
                                        <td class="col-qty">
                                            <span t-esc="'%.0f' % line.qty"/>
                                        </td>
                                        <td class="col-total">
                                            <span t-field="line.price_subtotal_incl" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="dashed-line"/>

                        <table>
                            <thead>
                                <tr>
                                    <th class="text-right" style="width: 35%;">Base</th>
                                    <th class="text-right" style="width: 35%;">Impuesto</th>
                                    <th class="text-right" style="width: 30%;">Cuota</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="move and move.tax_totals">
                                    <t t-foreach="move.tax_totals['subtotals']" t-as="subtotal">
                                        <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                            <tr>
                                                <td class="text-right">
                                                    <span t-out="tax_group['base_amount_currency']"
                                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                                <td class="text-right"><span t-out="tax_group['group_name']"/></td>
                                                <td class="text-right">
                                                    <span t-out="tax_group['tax_amount_currency']"
                                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td class="text-right">
                                            <span t-out="o.amount_total - o.amount_tax"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-right">IVA</td>
                                        <td class="text-right">
                                            <span t-out="o.amount_tax"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="dashed-line"/>

                        <table class="total-row">
                            <tr>
                                <td class="text-right bold">TOTAL</td>
                                <td class="text-right bold">
                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>

                        <div class="dashed-line"/>

                        <div class="center" style="margin-top: 5px;">
                            Pagado:
                            <t t-foreach="o.payment_ids" t-as="payment">
                                <span t-field="payment.payment_method_id.name"/>
                            </t>
                        </div>

                        <div class="dashed-line"/>

                        <t t-if="o.config_id and o.config_id.receipt_footer">
                            <div class="center" style="white-space: pre-line; margin-top: 5px;">
                                <span t-out="o.config_id.receipt_footer"/>
                            </div>
                        </t>
                        <div class="center" style="margin-top: 5px;">Gracias por su visita</div>
                        <div class="center">
                            Atendido por: <span t-field="o.user_id.name"/>
                            <span t-field="o.date_order" t-options='{"format": "HH:mm"}'/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
